<Application x:Class="SerialBridge.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SerialBridge.App"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:conv="clr-namespace:SerialBridge.App.Converters"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Light" />
                <ui:ControlsDictionary />
                <ResourceDictionary Source="Themes/AppStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
            <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
            <conv:InverseBoolConverter x:Key="InverseBool" />
            <conv:ZeroIndexToBoolConverter x:Key="ZeroIndexToBool" />
            <conv:BytesToTextConverter x:Key="BytesToText" />
            <conv:StringToBrushConverter x:Key="StringToBrush" />
            <conv:BoolToRunTextConverter x:Key="BoolToRunText" />
            <conv:RunToAppearanceConverter x:Key="RunToAppearance" />
            <conv:BoolToWeightConverter x:Key="BoolToWeight" />
            <conv:PauseTextConverter x:Key="PauseText" />
            <conv:PauseAppearanceConverter x:Key="PauseAppearance" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
