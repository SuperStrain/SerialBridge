<ui:FluentWindow
    x:Class="SerialBridge.App.Views.MappingEditWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="映射配置"
    Width="620" Height="720"
    MinWidth="560" MinHeight="660"
    WindowStartupLocation="CenterOwner"
    ResizeMode="NoResize"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica"
    Background="{DynamicResource ApplicationBackgroundBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="映射配置" Padding="8,0" />

        <ScrollViewer Grid.Row="1" Margin="28,10,28,0" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <TextBlock Text="基本信息" FontSize="14" FontWeight="SemiBold" Margin="0,4,0,10"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

                <TextBlock Text="映射名称" Style="{StaticResource FieldLabelStyle}" />
                <ui:TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                            MaxLength="40" PlaceholderText="例如：PLC-一号机" />

                <TextBlock Text="物理串口" Style="{StaticResource FieldLabelStyle}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox IsEditable="True" Text="{Binding PortName, UpdateSourceTrigger=PropertyChanged}"
                              ItemsSource="{Binding PortNames}" />
                    <ui:Button Grid.Column="1" Margin="8,0,0,0" Content="刷新串口"
                               Command="{Binding RefreshPortListCommand}" />
                </Grid>

                <Grid Margin="0,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="波特率" Style="{StaticResource FieldLabelStyle}" />
                        <ComboBox IsEditable="True" Text="{Binding BaudRateText, UpdateSourceTrigger=PropertyChanged}"
                                  ItemsSource="{Binding BaudRateOptions}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="数据位" Style="{StaticResource FieldLabelStyle}" />
                        <ComboBox SelectedItem="{Binding DataBits}" ItemsSource="{Binding DataBitsOptions}" />
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="校验位" Style="{StaticResource FieldLabelStyle}" />
                        <ComboBox ItemsSource="{Binding ParityOptions}" SelectedItem="{Binding Parity}" />
                    </StackPanel>
                </Grid>

                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="停止位" Style="{StaticResource FieldLabelStyle}" />
                        <ComboBox ItemsSource="{Binding StopBitsOptions}" SelectedItem="{Binding StopBits}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="流控" Style="{StaticResource FieldLabelStyle}" />
                        <ComboBox ItemsSource="{Binding HandshakeOptions}" SelectedItem="{Binding FlowControl}" />
                    </StackPanel>
                    <StackPanel Grid.Column="4" />
                </Grid>

                <Separator Margin="0,18,0,4" Background="{DynamicResource ControlStrokeColorDefaultBrush}" />
                <TextBlock Text="TCP 监听" FontSize="14" FontWeight="SemiBold" Margin="0,4,0,10"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="监听地址" Style="{StaticResource FieldLabelStyle}" />
                        <ComboBox ItemsSource="{Binding ListenIpOptions}" SelectedItem="{Binding ListenIp}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="监听端口" Style="{StaticResource FieldLabelStyle}" />
                        <ui:TextBox Text="{Binding ListenPortText, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="9001" />
                    </StackPanel>
                </Grid>
                <TextBlock FontSize="11.5" Margin="0,6,0,0" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           Text="0.0.0.0 表示监听本机所有网卡（推荐）。客户端请使用具体的局域网 IP 连接，而不是 0.0.0.0。" />

                <Separator Margin="0,18,0,4" Background="{DynamicResource ControlStrokeColorDefaultBrush}" />
                <TextBlock Text="客户端接入" FontSize="14" FontWeight="SemiBold" Margin="0,4,0,10"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

                <StackPanel Orientation="Horizontal">
                    <RadioButton GroupName="ClientMode" IsChecked="{Binding IsSingleClient}"
                                 Command="{Binding SetClientModeSingleCommand}"
                                 Content="单客户端模式（推荐）" />
                    <RadioButton GroupName="ClientMode" Margin="24,0,0,0"
                                 IsChecked="{Binding IsSingleClient, Converter={StaticResource InverseBool}}"
                                 Command="{Binding SetClientModeMultiCommand}"
                                 Content="多客户端模式（广播）" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,10,0,0"
                            IsEnabled="{Binding ClientModeIsSingle, Converter={StaticResource InverseBool}}">
                    <TextBlock Text="最大客户端数量" VerticalAlignment="Center" FontSize="13"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <ui:NumberBox Value="{Binding MaxClients, UpdateSourceTrigger=PropertyChanged}"
                                  Minimum="2" Maximum="64" SpinButtonPlacementMode="Inline"
                                  Width="130" Margin="12,0,0,0" ClearButtonEnabled="False" />
                </StackPanel>
                <TextBlock FontSize="11.5" Margin="0,6,0,0" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           Text="多客户端模式下，串口数据广播给所有客户端；多个客户端的数据按先后顺序写入串口，但不保证不同客户端之间的请求响应配对。" />

                <Separator Margin="0,18,0,4" Background="{DynamicResource ControlStrokeColorDefaultBrush}" />
                <TextBlock Text="运行选项" FontSize="14" FontWeight="SemiBold" Margin="0,4,0,10"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

                <CheckBox IsChecked="{Binding AutoReconnect}" Content="串口断开后自动重连" />
                <StackPanel Orientation="Horizontal" Margin="24,8,0,0"
                            IsEnabled="{Binding AutoReconnect}">
                    <TextBlock Text="重连间隔" VerticalAlignment="Center" FontSize="13"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <ui:TextBox Text="{Binding ReconnectSecondsText, UpdateSourceTrigger=PropertyChanged}"
                                Width="80" Margin="10,0,4,0" />
                    <TextBlock Text="秒（0.5 – 60）" VerticalAlignment="Center" FontSize="13"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <CheckBox IsChecked="{Binding AutoStart}" Content="软件启动时自动运行此映射" Margin="0,12,0,0" />

                <Border Background="#14DC2626" CornerRadius="6" Padding="12,8" Margin="0,14,0,0"
                        Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding ErrorMessage}" FontSize="12.5" TextWrapping="Wrap"
                               Foreground="#DC2626" />
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Padding="28,14"
                Background="{DynamicResource ApplicationBackgroundBrush}"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button Content="取消" MinWidth="96" IsCancel="True" Appearance="Secondary" />
                <ui:Button Content="保存" MinWidth="96" Margin="10,0,0,0" Appearance="Primary"
                           IsDefault="True" Click="OnSave" />
            </StackPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
