<ui:FluentWindow
    x:Class="SerialBridge.App.Views.MonitorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:SerialBridge.App.ViewModels"
    Title="数据监控"
    Width="980" Height="680"
    MinWidth="760" MinHeight="480"
    WindowStartupLocation="CenterOwner"
    Icon="pack://application:,,,/Assets/app.ico"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica"
    Background="{DynamicResource ApplicationBackgroundBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{Binding Title}" Padding="8,0" />

        <!-- 工具栏 -->
        <Border Grid.Row="1" Margin="20,8,20,8" Padding="14,10"
                Background="{DynamicResource ControlFillColorDefaultBrush}"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <RadioButton GroupName="DisplayMode" IsChecked="{Binding ShowHex, Mode=TwoWay}"
                                 Content="HEX 模式" FontWeight="{Binding ShowHex, Converter={StaticResource BoolToWeight}}" />
                    <RadioButton GroupName="DisplayMode" Margin="4,0,0,0"
                                 IsChecked="{Binding ShowHex, Converter={StaticResource InverseBool}, Mode=TwoWay}"
                                 Content="ASCII 模式" />
                    <ui:Button Margin="18,0,0,0" MinWidth="72"
                               Content="{Binding Paused, Converter={StaticResource PauseText}}"
                               Command="{Binding TogglePauseCommand}"
                               Appearance="{Binding Paused, Converter={StaticResource PauseAppearance}}" />
                    <ui:Button Margin="8,0,0,0" MinWidth="72" Content="清空"
                               Command="{Binding ClearCommand}" />
                    <ui:Button Margin="8,0,0,0" MinWidth="72" Content="导出"
                               Command="{Binding ExportCommand}" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="PeopleTeam24" FontSize="15"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock Margin="6,0,18,0" VerticalAlignment="Center" FontSize="13">
                        <Run Text="{Binding ClientCount, Mode=OneWay}" /><Run Text=" 个客户端" />
                    </TextBlock>
                    <CheckBox IsChecked="{Binding AutoScroll}" Content="自动滚动"
                              VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 数据列表 -->
        <Border Grid.Row="2" Margin="20,0,20,8"
                Background="{DynamicResource ControlFillColorDefaultBrush}"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="8"
                ClipToBounds="True">
            <ListBox x:Name="LinesList"
                     ItemsSource="{Binding Lines}"
                     FontFamily="Consolas"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling"
                     BorderThickness="0"
                     Background="Transparent">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:MonitorLine}">
                        <Grid Margin="4,1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="88" />
                                <ColumnDefinition Width="92" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding TimeText}" FontSize="12"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       VerticalAlignment="Top" />
                            <StackPanel Grid.Column="1">
                                <TextBlock FontSize="12" FontWeight="Medium" Foreground="#16A34A" Text="↑ OUT"
                                           Visibility="{Binding IsOutbound, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock FontSize="12" FontWeight="Medium" Foreground="#2563EB" Text="↓ IN"
                                           Visibility="{Binding IsOutbound, Converter={StaticResource InverseBoolToVisibility}}" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{Binding ContentText}" FontSize="12.5"
                                       TextWrapping="NoWrap"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- 状态栏 -->
        <Border Grid.Row="3" Margin="20,0,20,14" Padding="14,8"
                Background="{DynamicResource ControlFillColorDefaultBrush}"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="8">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="SerialPort24" FontSize="15"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock Margin="8,0,0,0" FontSize="12.5" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="{Binding SerialStateText}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock FontSize="12.5" Foreground="#16A34A" VerticalAlignment="Center">
                        <Run Text="设备→网络 " /><Run Text="{Binding RxText, Mode=OneWay}" FontWeight="Medium" />
                    </TextBlock>
                    <TextBlock FontSize="12.5" Margin="18,0,0,0" Foreground="#2563EB" VerticalAlignment="Center">
                        <Run Text="网络→设备 " /><Run Text="{Binding TxText, Mode=OneWay}" FontWeight="Medium" />
                    </TextBlock>
                    <TextBlock FontSize="12.5" Margin="18,0,0,0"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center">
                        <Run Text="{Binding LineCount, Mode=OneWay}" /><Run Text=" 条记录（最多缓存 3000 条）" />
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
