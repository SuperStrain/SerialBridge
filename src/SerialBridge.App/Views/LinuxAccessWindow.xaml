<ui:FluentWindow
    x:Class="SerialBridge.App.Views.LinuxAccessWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Linux 主机访问指南"
    Width="860" Height="720"
    MinWidth="700" MinHeight="520"
    WindowStartupLocation="CenterOwner"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica"
    Icon="pack://application:,,,/Assets/app.ico"
    Background="{DynamicResource ApplicationBackgroundBrush}">

    <ui:FluentWindow.Resources>
        <!-- 段落标题 -->
        <Style x:Key="HelpHeading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,18,0,6" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>
        <!-- 说明文字 -->
        <Style x:Key="HelpText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
        <!-- 可复制命令块 -->
        <Style x:Key="HelpCode" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
            <Setter Property="VerticalScrollBarVisibility" Value="Hidden" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Linux 主机访问指南" Padding="8,0" />

        <ScrollViewer Grid.Row="1" Margin="26,4,26,16" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <TextBlock Style="{StaticResource HelpText}" Margin="0,4,0,0"
                           Text="局域网内的 Linux 主机（Ubuntu 等）通过 TCP 连接映射端口，即可与串口设备双向通信。以下命令中的 192.168.1.100:9001 请替换为主界面显示的本机局域网地址。所有命令块均可选中复制。" />

                <TextBlock Style="{StaticResource HelpHeading}" Text="方式一：socat + picocom（推荐，交互体验最好）" />
                <TextBlock Style="{StaticResource HelpText}"
                           Text="socat 把 TCP 映射成本地虚拟终端（PTY），picocom 按真实串口终端的方式操作它——Tab 补全、Ctrl+C 的行为与物理接线完全一致。" />
                <TextBox Style="{StaticResource HelpCode}"
                         Text="sudo apt install socat picocom&#x0a;socat PTY,link=/tmp/ttydev,waitslave TCP:192.168.1.100:9001 &amp;&#x0a;picocom /tmp/ttydev" />
                <TextBlock Style="{StaticResource HelpText}"
                           Text="看到 Terminal ready 即已连上，可直接操作设备。退出 picocom：Ctrl+A 然后按 X。socat 挂在后台（&amp; 符号），会话结束后执行 pkill socat 清理；连接断开后旧 socat 实例自行退出属正常现象。picocom 显示的 baudrate 9600 等参数是本地虚拟终端的值，与通信无关——实际波特率由本软件的映射配置决定。" />

                <TextBlock Style="{StaticResource HelpHeading}" Text="方式二：脚本化访问（agent / 自动化对接）" />
                <TextBlock Style="{StaticResource HelpText}"
                           Text="程序对接不需要终端语义，直接用原始 socket 最可靠。随附工具（Python 3 标准库）封装了占用检测、登录、提示符等待、回显剥离，见软件附带的 serial-tcp-uart 技能目录。" />
                <TextBox Style="{StaticResource HelpCode}"
                         Text="python3 serial_session.py --host 192.168.1.100 --port 9001 exec &quot;uname -a&quot;" />

                <TextBlock Style="{StaticResource HelpHeading}" Text="方式三：nc（保留现有习惯的最小改法）" />
                <TextBlock Style="{StaticResource HelpText}"
                           Text="nc 的标准输入是行缓冲模式（icanon）：直接 nc 主机 端口 时，Tab、Ctrl+C 会被本地终端攒住直到回车才发送——表现为“Tab 补全不生效”。先把终端切成 raw 模式即可解决：" />
                <TextBox Style="{StaticResource HelpCode}"
                         Text="stty raw -echo; nc 192.168.1.100:9001; stty sane" />
                <TextBlock Style="{StaticResource HelpText}"
                           Text="raw 模式下 Ctrl+C 会作为 0x03 直接发给设备（对调试串口通常正是想要的行为）；nc 结束后务必执行 stty sane 恢复终端。" />

                <TextBlock Style="{StaticResource HelpHeading}" Text="不推荐：screen //telnet 与 telnet" />
                <TextBlock Style="{StaticResource HelpText}"
                           Text="screen 连接 TCP 需写 screen //telnet 主机 端口（直接写 IP 会报 Cannot exec），且实测 Tab 补全失灵——其 telnet 协议栈与哑透传对端先天不匹配。telnet 会把 0xFF 当作协议转义字符（IAC）处理并改写行尾，二进制协议必坏。两者均不建议用于本软件。" />

                <TextBlock Style="{StaticResource HelpHeading}" Text="简单对接示例（脚本 / 程序）" />
                <TextBlock Style="{StaticResource HelpText}" Text="纯 bash（无需安装任何工具）：" />
                <TextBox Style="{StaticResource HelpCode}"
                         Text="exec 3&lt;&gt;/dev/tcp/192.168.1.100/9001; printf 'AT\r' &gt;&amp;3; head -c 64 &lt;&amp;3 | xxd" />
                <TextBlock Style="{StaticResource HelpText}" Text="Python：" />
                <TextBox Style="{StaticResource HelpCode}"
                         Text="python3 -c &quot;import socket;s=socket.create_connection(('192.168.1.100',9001));s.sendall(b'AT\r');print(s.recv(256))&quot;" />

                <TextBlock Style="{StaticResource HelpHeading}" Text="本机 Windows 软件访问（Xshell / PuTTY / MobaXterm）" />
                <TextBlock Style="{StaticResource HelpText}"
                           Text="本机（Windows 电脑）不需要绕道局域网 IP——直接连接 127.0.0.1:9001 即可，与远程访问完全等价。此外软件自带“串口终端”窗口（映射卡片上的对话框图标），无需任何第三方工具即可直接与设备交互。" />
                <TextBox Style="{StaticResource HelpCode}"
                         Text="PuTTY / MobaXterm: 协议选 Raw，主机 127.0.0.1，端口 9001（无协议层，等价真实串口）&#x0a;Xshell:            新建会话，协议选 TELNET，主机 127.0.0.1，端口 9001（文本调试适用）&#x0a;SerialBridge:      映射卡片 → 串口终端按钮（推荐，Tab 补全 / Ctrl+C / 历史命令）" />
                <TextBlock Style="{StaticResource HelpText}"
                           Text="注意：SSCom 等仅支持 COM 口的串口工具无法直连 TCP 端口，请使用内置串口终端或上述支持 Raw/Telnet 的终端软件。" />

                <TextBlock Style="{StaticResource HelpHeading}" Text="连接被拒绝 / 无法访问？" />
                <TextBlock Style="{StaticResource HelpText}"
                           Text="1. 映射默认为单客户端模式：已有客户端在线时新连接会被立即关闭。多台主机需要同时访问时，在映射配置里改用多客户端模式（串口数据会广播给所有客户端，多个客户端写入按先后顺序串行化，但不保证不同客户端的请求响应配对）。" />
                <TextBlock Style="{StaticResource HelpText}"
                           Text="2. 首次使用请在主界面点击“添加防火墙规则”放行本程序入站。" />
                <TextBlock Style="{StaticResource HelpText}"
                           Text="3. 连接地址请使用主界面显示的具体局域网 IP（如 192.168.1.100），而不是 0.0.0.0。" />

                <TextBlock Style="{StaticResource HelpHeading}" Text="安全提示" />
                <TextBlock Style="{StaticResource HelpText}"
                           Text="原始 TCP 透传不包含加密与客户端身份认证，任何能建立 TCP 连接的程序都可以收发数据。请仅在可信局域网内使用；可通过映射的“监听地址”限定网卡，并在路由/防火墙层面控制访问来源。" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</ui:FluentWindow>
