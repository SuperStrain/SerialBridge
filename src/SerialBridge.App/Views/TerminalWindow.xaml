<ui:FluentWindow
    x:Class="SerialBridge.App.Views.TerminalWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:SerialBridge.App.ViewModels"
    Title="串口终端"
    Width="900" Height="640"
    MinWidth="720" MinHeight="480"
    WindowStartupLocation="CenterOwner"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica"
    Icon="pack://application:,,,/Assets/app.ico"
    Background="{DynamicResource ApplicationBackgroundBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{Binding Title}" Padding="8,0" />

        <!-- 工具栏 -->
        <Border Grid.Row="1" Margin="20,8,20,8" Padding="14,10"
                Background="{DynamicResource ControlFillColorDefaultBrush}"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <RadioButton GroupName="TermDisplayMode" IsChecked="{Binding ShowHex, Mode=TwoWay}"
                                 Content="HEX 模式" />
                    <RadioButton GroupName="TermDisplayMode" Margin="4,0,0,0"
                                 IsChecked="{Binding ShowHex, Converter={StaticResource InverseBool}, Mode=TwoWay}"
                                 Content="ASCII 模式" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button Content="Ctrl+C (0x03)" ToolTip="发送 Ctrl+C，打断设备当前程序/输入"
                               Command="{Binding SendCtrlCCommand}" Margin="0,0,8,0" />
                    <ui:Button Content="Ctrl+Z (0x1A)" ToolTip="发送 Ctrl+Z"
                               Command="{Binding SendCtrlZCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 设备输出显示区 -->
        <Border Grid.Row="2" Margin="20,0,20,8"
                Background="{DynamicResource ControlFillColorDefaultBrush}"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="8" ClipToBounds="True">
            <ListBox x:Name="OutputList"
                     ItemsSource="{Binding Lines}"
                     FontFamily="Consolas"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling"
                     BorderThickness="0" Background="Transparent">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:MonitorLine}">
                        <Grid Margin="4,1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="88" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding TimeText}" FontSize="12"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            <TextBlock Grid.Column="1" Text="{Binding ContentText}" FontSize="12.5"
                                       TextWrapping="NoWrap"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- 输入区 -->
        <Border Grid.Row="3" Margin="20,0,20,14" Padding="14,10"
                Background="{DynamicResource ControlFillColorDefaultBrush}"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="8"
                IsEnabled="{Binding CanSend}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBox x:Name="InputBox" Grid.Column="0"
                                Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="输入内容，回车发送（↑/↓ 翻阅历史）"
                                KeyDown="OnInputKeyDown" />
                    <CheckBox Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"
                              IsChecked="{Binding HexMode}"
                              Content="HEX 发送" ToolTip="勾选后输入按十六进制解析发送（如 41 54 0D），不追加回车" />
                </Grid>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0">
                    <ui:Button Content="发送" Appearance="Primary" MinWidth="86"
                               Command="{Binding SendCommand}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
