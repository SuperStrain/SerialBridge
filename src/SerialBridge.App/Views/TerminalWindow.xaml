<ui:FluentWindow
    x:Class="SerialBridge.App.Views.TerminalWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
    Title="串口终端"
    Width="920" Height="640"
    MinWidth="720" MinHeight="480"
    WindowStartupLocation="CenterOwner"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="None"
    Icon="pack://application:,,,/Assets/app.ico"
    Opacity="0"
    Background="#1E1E2E">

    <ui:FluentWindow.Resources>
        <!-- 自绘深色标题栏按钮（浅色主题下 ui:TitleBar 的深色图标在深色背景上不可见） -->
        <Style x:Key="TermCaptionButton" TargetType="Button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#C8CEDA" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#3B4261" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TermCloseButton" TargetType="Button" BasedOn="{StaticResource TermCaptionButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#D0342C" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 自绘深色标题栏：拖动区 + 窗口控制按钮 -->
        <Border Grid.Row="0" Background="#181825" Height="38"
                MouseLeftButtonDown="OnTitleBarMouseLeftButtonDown">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <ui:SymbolIcon Symbol="ChatMultiple24" FontSize="14" Foreground="#89B4FA" />
                    <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" FontSize="12.5"
                               Foreground="#DCD7CF" Text="{Binding Title}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource TermCaptionButton}" Content="&#xE921;"
                            ToolTip="最小化" Click="OnMinimizeClick" />
                    <Button x:Name="MaxRestoreButton" Style="{StaticResource TermCaptionButton}"
                            Content="&#xE922;" ToolTip="最大化/还原" Click="OnMaximizeClick" />
                    <Button Style="{StaticResource TermCloseButton}" Content="&#xE8BB;"
                            ToolTip="关闭（收起到托盘）" Click="OnCloseClick" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 工具条：状态 + 流量 + 清屏 -->
        <Border Grid.Row="1" Background="#181825" Padding="14,4,14,10">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="ChatMultiple24" FontSize="15" Foreground="#89B4FA" />
                    <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" FontSize="13"
                               Foreground="#DCD7CF" Text="{Binding StateText}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock VerticalAlignment="Center" Margin="0,0,14,0" FontSize="12"
                               Foreground="#9399B2">
                        <Run Text="↑ " /><Run Text="{Binding TxText, Mode=OneWay}" />
                        <Run Text="  ↓ " /><Run Text="{Binding RxText, Mode=OneWay}" />
                    </TextBlock>
                    <ui:Button Content="清屏" Click="OnClearScreen"
                               ToolTip="清除终端显示（不影响设备）" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- xterm.js 终端（Xshell 级体验：光标、转义序列、逐键透传） -->
        <Grid Grid.Row="2" Background="#1E1E2E">
            <Border x:Name="TerminalLoadingHost" Background="#1E1E2E"
                    IsHitTestVisible="False">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ProgressBar Width="180" Height="3" IsIndeterminate="True"
                                 Foreground="#89B4FA" Background="#313244" />
                    <TextBlock x:Name="TerminalLoadingText" Margin="0,14,0,0"
                               HorizontalAlignment="Center" FontSize="12.5"
                               Foreground="#9399B2" Text="正在初始化终端…" />
                </StackPanel>
            </Border>
            <wv2:WebView2 x:Name="Web" Visibility="Hidden"
                          DefaultBackgroundColor="#1E1E2E" />
        </Grid>

        <Border Grid.Row="3" Background="#181825" Padding="14,6">
            <TextBlock FontSize="11.5" Foreground="#9399B2"
                       Text="逐键透传模式：所有按键（含 Tab/Ctrl+C/方向键）直接发送到设备，回显由设备决定——与 Xshell 串口一致。复制：选中文字后 Ctrl+Shift+C；粘贴：Ctrl+Shift+V" />
        </Border>
    </Grid>
</ui:FluentWindow>
