<ui:FluentWindow
    x:Class="SerialBridge.App.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:SerialBridge.App.ViewModels"
    xmlns:conv="clr-namespace:SerialBridge.App.Converters"
    xmlns:tb="clr-namespace:H.NotifyIcon;assembly=H.NotifyIcon.Wpf"
    Title="SerialBridge — 串口网络桥接工具"
    Width="1180" Height="820"
    MinWidth="960" MinHeight="640"
    WindowStartupLocation="CenterScreen"
    Icon="pack://application:,,,/Assets/app.ico"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica"
    Background="{DynamicResource ApplicationBackgroundBrush}">

    <ui:FluentWindow.Resources>
        <!-- 系统托盘图标 -->
        <tb:TaskbarIcon
            x:Key="TrayIcon"
            IconSource="pack://application:,,,/Assets/app.ico"
            ToolTipText="SerialBridge"
            TrayLeftMouseUp="OnTrayIconClick"
            Visibility="Visible">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="打开主窗口" FontWeight="Medium" Click="OnTrayShowClick" />
                    <Separator />
                    <MenuItem Header="全部启动映射" Click="OnTrayStartAllClick" />
                    <MenuItem Header="全部停止映射" Click="OnTrayStopAllClick" />
                    <Separator />
                    <MenuItem Header="退出" Click="OnTrayExitClick" />
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>

        <conv:BytesToTextConverter x:Key="BytesToText" />
        <conv:BoolToRunTextConverter x:Key="BoolToRunText" />
        <conv:StringToBrushConverter x:Key="StringToBrush" />

        <!-- 紧凑映射表格行，功能命令继续使用原 MappingViewModel。 -->
        <DataTemplate x:Key="MappingCardTemplate" DataType="{x:Type vm:MappingViewModel}">
            <Border Background="{DynamicResource ControlFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="0,0,0,1" Padding="8,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="2.2*" MinWidth="132" />
                        <ColumnDefinition Width="1.55*" MinWidth="112" />
                        <ColumnDefinition Width="1.7*" MinWidth="130" />
                        <ColumnDefinition Width="0.85*" MinWidth="72" />
                        <ColumnDefinition Width="1.4*" MinWidth="100" />
                        <ColumnDefinition Width="1.1*" MinWidth="96" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="4" HorizontalAlignment="Left" CornerRadius="3"
                            Background="{Binding StateBrush, Converter={StaticResource StringToBrush}}" />
                    <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="{Binding ModeText}" FontSize="11" Margin="0,3,0,0"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        <TextBlock Text="{Binding CaptureStatusText}" FontSize="11" Foreground="#0891B2"
                                   Cursor="Hand" MouseLeftButtonDown="OnCaptureBadgeClick"
                                   ToolTip="打开串口日志目录" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="4,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Config.PortName}" FontWeight="Medium" FontSize="13" />
                        <TextBlock Text="{Binding SerialSummary}" FontSize="11"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding SerialSummary}"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <StackPanel Grid.Column="3" Margin="4,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ListenAddress}" FontSize="12.5" FontWeight="Medium"
                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding ListenAddress}" />
                        <TextBlock Text="监听地址 · 点击上方 IPv4 查看可访问地址" FontSize="10.5"
                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding AccessAddress}"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    </StackPanel>
                    <ui:Button Grid.Column="4" Appearance="Transparent" Padding="5,5"
                               HorizontalAlignment="Left" VerticalAlignment="Center"
                               AutomationProperties.AutomationId="OpenClientsButton"
                               ToolTip="查看已连接的客户端" Command="{Binding OpenClientsCommand}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="PeopleTeam24" FontSize="16" />
                            <TextBlock Text="{Binding ClientCount}" Margin="5,0,0,0" />
                        </StackPanel>
                    </ui:Button>
                    <StackPanel Grid.Column="5" VerticalAlignment="Center" Margin="4,0">
                        <TextBlock Foreground="#16A34A" FontSize="12">
                            <Run Text="↓ " /><Run Text="{Binding RxBytes, Converter={StaticResource BytesToText}}" />
                        </TextBlock>
                        <TextBlock Foreground="#B45309" FontSize="12" Margin="0,3,0,0">
                            <Run Text="↑ " /><Run Text="{Binding TxBytes, Converter={StaticResource BytesToText}}" />
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Grid.Column="6" Margin="4,0" VerticalAlignment="Center">
                        <Border CornerRadius="12" Background="#1A16A34A" Padding="7,4" HorizontalAlignment="Left">
                            <TextBlock Text="{Binding StateText}" FontSize="11.5" Foreground="#16A34A" />
                        </Border>
                        <TextBlock Text="{Binding FaultMessage}" FontSize="10.5" Foreground="#DC2626"
                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding FaultMessage}"
                                   Visibility="{Binding HasFault, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                    <StackPanel Grid.Column="7" Orientation="Horizontal" VerticalAlignment="Center" Margin="2,0,0,0">
                        <ui:Button Command="{Binding OpenTerminalCommand}" Padding="9,6"
                                   ToolTip="打开本机串口终端">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="ChatMultiple24" FontSize="15" />
                                <TextBlock Text="终端" Margin="4,0,0,0" />
                            </StackPanel>
                        </ui:Button>
                        <ui:Button Command="{Binding ToggleRunCommand}" Margin="5,0,0,0" Padding="9,6"
                                   ToolTip="启动或停止当前映射">
                            <ui:SymbolIcon Symbol="RecordStop24" FontSize="16" />
                        </ui:Button>
                        <ui:Button Margin="5,0,0,0" Padding="9,6" ToolTip="更多映射操作">
                            <ui:SymbolIcon Symbol="MoreHorizontal24" FontSize="16" />
                            <ui:Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="启动 / 停止" Command="{Binding ToggleRunCommand}" />
                                    <MenuItem Header="查看客户端" Command="{Binding OpenClientsCommand}" />
                                    <MenuItem Header="数据监控" Command="{Binding OpenMonitorCommand}" />
                                    <MenuItem Header="打开日志目录" Command="{Binding OpenCaptureFolderCommand}" />
                                    <Separator />
                                    <MenuItem Header="编辑映射" Command="{Binding EditCommand}" />
                                    <MenuItem Header="删除映射" Command="{Binding DeleteCommand}" />
                                </ContextMenu>
                            </ui:Button.ContextMenu>
                        </ui:Button>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </ui:FluentWindow.Resources>

    <!-- 主区域：左侧真实功能导航 + 右侧映射工作台。 -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Title="SerialBridge 串口网络桥接" Padding="8,0" />
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="205" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左侧导航：不重复放置远程连接、设置入口。 -->
            <Border Grid.Column="0" Background="{DynamicResource ControlFillColorSecondaryBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="0,0,1,0">
                <DockPanel Margin="15,20,15,14" LastChildFill="True">
                    <StackPanel DockPanel.Dock="Top">
                        <StackPanel Orientation="Horizontal" Margin="3,2,0,25">
                            <Image Width="44" Height="44" Source="pack://application:,,,/Assets/app-logo.png"
                                   Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                            <StackPanel VerticalAlignment="Center" Margin="9,0,0,0">
                                <TextBlock Text="SerialBridge" FontSize="17" FontWeight="Bold" />
                                <TextBlock Text="串口网络桥接工具" FontSize="10.5"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </StackPanel>
                        <ui:Button Appearance="Primary" HorizontalContentAlignment="Left"
                                   Height="46" Padding="13,0" ToolTip="当前页面：本机串口映射">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="SerialPort24" FontSize="19" />
                                <TextBlock Text="串口映射" Margin="13,0,0,0" FontWeight="SemiBold" />
                            </StackPanel>
                        </ui:Button>
                        <ui:Button Appearance="Transparent" Height="46" Padding="13,0"
                                   HorizontalContentAlignment="Left" Click="OnOpenRemoteConnections"
                                   ToolTip="连接同一局域网内其他 SerialBridge 的 TCP 串口服务">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Desktop24" FontSize="19" />
                                <TextBlock Text="远程连接" Margin="13,0,0,0" />
                            </StackPanel>
                        </ui:Button>
                        <Separator Margin="3,15" />
                        <ui:Button Appearance="Transparent" Height="46" Padding="13,0"
                                   HorizontalContentAlignment="Left" Click="OnOpenSettings">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Options24" FontSize="19" />
                                <TextBlock Text="设置" Margin="13,0,0,0" />
                            </StackPanel>
                        </ui:Button>
                        <ui:Button Appearance="Transparent" Height="46" Padding="13,0"
                                   HorizontalContentAlignment="Left" Click="OnOpenAbout">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Info24" FontSize="19" />
                                <TextBlock Text="关于" Margin="13,0,0,0" />
                            </StackPanel>
                        </ui:Button>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Bottom" Margin="5,10,0,0">
                        <Border Background="#1816A34A" CornerRadius="8" Padding="11,8">
                            <TextBlock FontSize="12.5" Foreground="#16A34A"
                                       Text="{Binding StatusSummary}" TextTrimming="CharacterEllipsis" />
                        </Border>
                        <TextBlock Margin="8,12,0,0" FontSize="11.5"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                            <Run Text="v" /><Run Text="{Binding AppVersion}" />
                        </TextBlock>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Grid Grid.Column="1" Margin="24,16,24,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 工作区标题和常用帮助；Linux 访问是说明文档，不作为连接按钮出现。 -->
                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="串口映射" FontSize="24" FontWeight="SemiBold" />
                            <Border x:Name="UpdateBadge" Margin="10,0,0,0"
                                    Background="#1A16A34A" CornerRadius="4" Padding="7,2"
                                    VerticalAlignment="Center" Cursor="Hand"
                                    MouseLeftButtonDown="OnUpdateBadgeClick"
                                    ToolTip="{Binding UpdateBadgeVersion}"
                                    Visibility="{Binding UpdateBadgeVisible, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="NEW" FontSize="11" FontWeight="Bold" Foreground="#16A34A" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="将本地物理串口转换为 TCP 服务，供局域网内的设备与 AI Agent 访问"
                                   Margin="0,5,0,0" FontSize="12.5"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                        <ui:Button ToolTip="切换深浅主题" Click="OnToggleTheme" Padding="10,7">
                            <ui:SymbolIcon Symbol="DarkTheme24" x:Name="ThemeIcon" />
                        </ui:Button>
                        <ui:Button ToolTip="帮助和使用指南" Margin="8,0,0,0"
                                   Padding="10,7" Click="OnOpenHelp">
                            <ui:SymbolIcon Symbol="QuestionCircle24" />
                        </ui:Button>
                    </StackPanel>
                </Grid>

                <!-- 统计总览：保留四项实时信息但减小视觉噪音。 -->
                <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,15">
                    <Border Style="{StaticResource StatCardStyle}">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="38" Height="38" Background="#1416A34A" CornerRadius="8">
                                <ui:SymbolIcon Symbol="LinkMultiple24" Foreground="#16A34A" FontSize="20" />
                            </Border>
                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="运行映射" FontSize="11.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding RunningCount}" FontWeight="Bold" FontSize="20" />
                                    <TextBlock Text=" / " FontWeight="Bold" FontSize="20" />
                                    <TextBlock Text="{Binding TotalCount}" FontWeight="Bold" FontSize="20" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource StatCardStyle}">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="38" Height="38" Background="#142563EB" CornerRadius="8">
                                <ui:SymbolIcon Symbol="PeopleTeam24" Foreground="#2563EB" FontSize="20" />
                            </Border>
                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="在线客户端" FontSize="11.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{Binding TotalClients}" FontWeight="Bold" FontSize="20" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource StatCardStyle}">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="38" Height="38" Background="#1416A34A" CornerRadius="8">
                                <ui:SymbolIcon Symbol="ArrowImport24" Foreground="#16A34A" FontSize="20" />
                            </Border>
                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="累计接收" FontSize="11.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{Binding TotalRxText}" FontWeight="Bold" FontSize="19" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource StatCardStyle}">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="38" Height="38" Background="#14B45309" CornerRadius="8">
                                <ui:SymbolIcon Symbol="ArrowUpload24" Foreground="#B45309" FontSize="20" />
                            </Border>
                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="累计发送" FontSize="11.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{Binding TotalTxText}" FontWeight="Bold" FontSize="19" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- 操作区：IP 地址默认收起，真实地址通过弹窗显示。 -->
                <Grid Grid.Row="2" Margin="0,0,0,14">
                    <StackPanel Orientation="Horizontal">
                        <ui:Button Appearance="Primary" Command="{Binding AddMappingCommand}" MinWidth="116">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="AddCircle24" />
                                <TextBlock Text="新增映射" Margin="6,0,0,0" />
                            </StackPanel>
                        </ui:Button>
                        <ui:Button Margin="10,0,0,0" Command="{Binding StartAllCommand}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="PlayCircle24" />
                                <TextBlock Text="全部启动" Margin="6,0,0,0" />
                            </StackPanel>
                        </ui:Button>
                        <ui:Button Margin="10,0,0,0" Command="{Binding StopAllCommand}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="RecordStop24" />
                                <TextBlock Text="全部停止" Margin="6,0,0,0" />
                            </StackPanel>
                        </ui:Button>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <ui:Button ToolTip="{Binding LocalIpSummary}" Click="OnShowLocalIps" Padding="10,7">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Earth24" />
                                <TextBlock Text="本机 IPv4 · 查看地址" Margin="6,0,0,0" />
                            </StackPanel>
                        </ui:Button>
                        <ui:Button Margin="9,0,0,0" Command="{Binding RefreshPortsCommand}" ToolTip="刷新串口和网络地址">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="ArrowSync24" />
                                <TextBlock Text="刷新" Margin="6,0,0,0" />
                            </StackPanel>
                        </ui:Button>
                    </StackPanel>
                </Grid>

                <!-- 表头与行使用完全一致的列宽约束；需要时可水平滚动。 -->
                <Border Grid.Row="3" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="9" Background="{DynamicResource ControlFillColorSecondaryBrush}">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <Grid MinWidth="840">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Background="{DynamicResource ControlFillColorDefaultBrush}" Padding="8,12"
                                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="6" />
                                        <ColumnDefinition Width="2.2*" MinWidth="132" />
                                        <ColumnDefinition Width="1.55*" MinWidth="112" />
                                        <ColumnDefinition Width="1.7*" MinWidth="130" />
                                        <ColumnDefinition Width="0.85*" MinWidth="72" />
                                        <ColumnDefinition Width="1.4*" MinWidth="100" />
                                        <ColumnDefinition Width="1.1*" MinWidth="96" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="1" Text="映射名称" Margin="10,0,0,0" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="2" Text="串口配置" Margin="4,0,0,0" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="3" Text="TCP 服务" Margin="4,0,0,0" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="4" Text="客户端" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="5" Text="流量（累计）" Margin="4,0,0,0" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="6" Text="状态" Margin="4,0,0,0" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="7" Text="操作" FontWeight="SemiBold" />
                                </Grid>
                            </Border>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <ItemsControl ItemsSource="{Binding Mappings}" ItemTemplate="{StaticResource MappingCardTemplate}" />
                                    <StackPanel Margin="0,35" HorizontalAlignment="Center"
                                                Visibility="{Binding HasMappings, Converter={StaticResource InverseBoolToVisibility}}">
                                        <ui:SymbolIcon Symbol="SerialPort24" FontSize="32" HorizontalAlignment="Center" />
                                        <TextBlock Text="还没有串口映射" FontSize="15" Margin="0,12,0,5" HorizontalAlignment="Center" />
                                        <TextBlock Text="点击上方“新增映射”开始配置" FontSize="12"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </ScrollViewer>
                </Border>

                <StackPanel Grid.Row="4" Margin="0,9,0,0">
                    <Border Background="#14B45309" BorderBrush="#55B45309" BorderThickness="1"
                            CornerRadius="6" Padding="10,8"
                            Visibility="{Binding FirewallWarningVisible, Converter={StaticResource BoolToVisibility}}">
                        <DockPanel LastChildFill="True">
                            <ui:Button DockPanel.Dock="Right" Appearance="Caution"
                                       Content="添加防火墙规则" Command="{Binding AddFirewallRuleCommand}" />
                            <TextBlock FontSize="11.5" TextWrapping="Wrap" VerticalAlignment="Center">
                                未检测到本程序防火墙入站规则。TCP 透传不含认证或加密，仅在可信局域网使用。
                            </TextBlock>
                        </DockPanel>
                    </Border>
                    <Grid Margin="0,7,0,0">
                        <TextBlock HorizontalAlignment="Left" FontSize="11"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   Text="{Binding RefreshedAtText}" />
                        <TextBlock HorizontalAlignment="Right" FontSize="11"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                            <Hyperlink NavigateUri="https://github.com/SuperStrain/SerialBridge"
                                       RequestNavigate="OnOpenGitHub" Foreground="#2563EB">
                                GitHub 开源地址
                            </Hyperlink>
                        </TextBlock>
                    </Grid>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
