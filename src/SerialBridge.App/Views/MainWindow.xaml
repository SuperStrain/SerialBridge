<ui:FluentWindow
    x:Class="SerialBridge.App.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:SerialBridge.App.ViewModels"
    xmlns:conv="clr-namespace:SerialBridge.App.Converters"
    xmlns:tb="clr-namespace:H.NotifyIcon;assembly=H.NotifyIcon.Wpf"
    Title="SerialBridge — 串口网络桥接工具"
    Width="1180" Height="820"
    MinWidth="960" MinHeight="640"
    WindowStartupLocation="CenterScreen"
    Icon="pack://application:,,,/Assets/app.ico"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica"
    Background="{DynamicResource ApplicationBackgroundBrush}">

    <ui:FluentWindow.Resources>
        <!-- 系统托盘图标 -->
        <tb:TaskbarIcon
            x:Key="TrayIcon"
            IconSource="pack://application:,,,/Assets/app.ico"
            ToolTipText="SerialBridge"
            TrayLeftMouseUp="OnTrayIconClick"
            Visibility="Visible">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="打开主窗口" FontWeight="Medium" Click="OnTrayShowClick" />
                    <Separator />
                    <MenuItem Header="全部启动映射" Click="OnTrayStartAllClick" />
                    <MenuItem Header="全部停止映射" Click="OnTrayStopAllClick" />
                    <Separator />
                    <MenuItem Header="退出" Click="OnTrayExitClick" />
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>

        <conv:BytesToTextConverter x:Key="BytesToText" />
        <conv:BoolToRunTextConverter x:Key="BoolToRunText" />
        <conv:StringToBrushConverter x:Key="StringToBrush" />

        <!-- 单条映射卡片模板 -->
        <DataTemplate x:Key="MappingCardTemplate" DataType="{x:Type vm:MappingViewModel}">
            <Border
                Background="{DynamicResource ControlFillColorDefaultBrush}"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="8" Padding="20,16" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- 状态色条 -->
                    <Border Grid.Column="0" Width="4" Margin="0,4,16,4"
                            CornerRadius="2"
                            Background="{Binding StateBrush, Converter={StaticResource StringToBrush}}" />

                    <!-- 信息区 -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <Border Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                    CornerRadius="4" Padding="6,2" Margin="10,2,0,0"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding ModeText}" FontSize="11"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </Border>
                            <Border CornerRadius="4" Padding="6,2" Margin="6,2,0,0" VerticalAlignment="Center"
                                    Background="#1A16A34A">
                                <TextBlock FontSize="11" Foreground="#16A34A">
                                    <Run Text="● " /><Run Text="{Binding StateText, Mode=OneWay}" />
                                </TextBlock>
                            </Border>
                            <TextBlock Margin="8,2,0,0" VerticalAlignment="Center" FontSize="11"
                                       Foreground="#0891B2" Cursor="Hand"
                                       MouseLeftButtonDown="OnCaptureBadgeClick"
                                       ToolTip="点击打开串口日志目录"
                                       Text="{Binding CaptureStatusText, Mode=OneWay}" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <ui:SymbolIcon Symbol="SerialPort24" FontSize="15"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{Binding SerialSummary}" Margin="6,0,18,0" FontSize="13"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <ui:SymbolIcon Symbol="Earth24" FontSize="15"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock Margin="6,0,0,0" FontSize="13"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                <Run Text="监听 " /><Run Text="{Binding ListenAddress, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <ui:SymbolIcon Symbol="LinkMultiple24" FontSize="15"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            <TextBlock Margin="6,0,0,0" FontSize="12.5"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       ToolTip="局域网内设备使用该地址连接">
                                <Run Text="客户端连接地址：" />
                                <Run Text="{Binding AccessAddress, Mode=OneWay}" FontWeight="Medium" />
                            </TextBlock>
                            <TextBlock Margin="16,0,0,0" FontSize="12.5"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       Text="{Binding SerialStateText}" />
                            <TextBlock Margin="16,0,0,0" FontSize="12.5"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       ToolTip="本机软件（PuTTY Raw/Xshell Telnet/内置串口终端）可使用的连接地址">
                                <Run Text="本机连接: " />
                                <Run Text="{Binding LocalAddress, Mode=OneWay}" FontWeight="Medium" />
                            </TextBlock>
                        </StackPanel>

                        <!-- 错误/提示 -->
                        <TextBlock Margin="0,8,0,0" FontSize="12.5" TextWrapping="Wrap"
                                   Foreground="#DC2626"
                                   Visibility="{Binding HasFault, Converter={StaticResource BoolToVisibility}}">
                            <Run Text="⚠ " /><Run Text="{Binding FaultMessage, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>

                    <!-- 统计区 -->
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,20,0">
                        <ui:Button HorizontalAlignment="Right"
                                   AutomationProperties.AutomationId="OpenClientsButton"
                                   Appearance="Transparent"
                                   ToolTip="查看客户端详情"
                                   Content="{Binding ClientsButtonText, Mode=OneWay}"
                                   Command="{Binding OpenClientsCommand}"
                                   Padding="8,4" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0" HorizontalAlignment="Right">
                            <TextBlock FontSize="12.5" Foreground="#0E7490">
                                <Run Text="↓ " /><Run Text="{Binding RxBytes, Mode=OneWay, Converter={StaticResource BytesToText}}" />
                            </TextBlock>
                            <TextBlock FontSize="12.5" Margin="14,0,0,0" Foreground="#B45309">
                                <Run Text="↑ " /><Run Text="{Binding TxBytes, Mode=OneWay, Converter={StaticResource BytesToText}}" />
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>

                    <!-- 操作区 -->
                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:Button Command="{Binding ToggleRunCommand}"
                                   Appearance="{Binding IsRunning, Converter={StaticResource RunToAppearance}}"
                                   Content="{Binding IsRunning, Converter={StaticResource BoolToRunText}}"
                                   MinWidth="76" />
                        <ui:Button ToolTip="串口终端：在软件内直接与设备交互" Margin="8,0,0,0"
                                   Command="{Binding OpenTerminalCommand}">
                            <ui:SymbolIcon Symbol="ChatMultiple24" />
                        </ui:Button>
                        <ui:Button ToolTip="数据监控" Margin="8,0,0,0" Command="{Binding OpenMonitorCommand}">
                            <ui:SymbolIcon Symbol="ArrowSwap24" />
                        </ui:Button>
                        <ui:Button ToolTip="编辑" Margin="8,0,0,0" Command="{Binding EditCommand}">
                            <ui:SymbolIcon Symbol="EditSettings24" />
                        </ui:Button>
                        <ui:Button ToolTip="删除" Margin="8,0,0,0" Command="{Binding DeleteCommand}">
                            <ui:SymbolIcon Symbol="DeleteDismiss24" />
                        </ui:Button>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <ui:TitleBar Grid.Row="0" Title="SerialBridge 串口网络桥接" Padding="8,0" />

        <!-- 页头 -->
        <Grid Grid.Row="1" Margin="32,16,32,8">
            <StackPanel Orientation="Horizontal">
                <Border Width="42" Height="42" CornerRadius="10" Background="#2563EB">
                    <ui:SymbolIcon Symbol="ArrowSwap24" FontSize="22" Foreground="White" />
                </Border>
                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="SerialBridge" FontSize="22" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock Text="串口网络桥接工具 — 物理串口 ↔ TCP/IP 双向透明转发"
                               FontSize="12.5"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <ui:Button ToolTip="Linux 主机访问指南（可复制命令）" Click="OnOpenLinuxAccess" Appearance="Secondary">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="BookGlobe24" />
                        <TextBlock Text="Linux 访问" Margin="6,0,0,0" />
                    </StackPanel>
                </ui:Button>
                <ui:Button ToolTip="切换深浅主题" Margin="8,0,0,0" Click="OnToggleTheme" Appearance="Secondary">
                    <ui:SymbolIcon Symbol="DarkTheme24" x:Name="ThemeIcon" />
                </ui:Button>
                <ui:Button ToolTip="设置" Margin="8,0,0,0" Click="OnOpenSettings" Appearance="Secondary">
                    <ui:SymbolIcon Symbol="Options24" />
                </ui:Button>
            </StackPanel>
        </Grid>

        <!-- 统计卡片 -->
        <UniformGrid Grid.Row="2" Columns="4" Margin="32,12,32,4">
            <Border Style="{StaticResource StatCardStyle}">
                <StackPanel Orientation="Horizontal">
                    <Border Width="38" Height="38" CornerRadius="8" Background="#142563EB">
                        <ui:SymbolIcon Symbol="PlayCircle24" FontSize="20" Foreground="#2563EB" />
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource StatValueStyle}" Text="{Binding RunningCount, Mode=OneWay}" />
                        <TextBlock Style="{StaticResource StatLabelStyle}"
                                   Text="{Binding StatusSummary, Mode=OneWay}" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource StatCardStyle}">
                <StackPanel Orientation="Horizontal">
                    <Border Width="38" Height="38" CornerRadius="8" Background="#140E7490">
                        <ui:SymbolIcon Symbol="PeopleTeam24" FontSize="20" Foreground="#0E7490" />
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource StatValueStyle}" Text="{Binding TotalClients, Mode=OneWay}" />
                        <TextBlock Style="{StaticResource StatLabelStyle}" Text="TCP 客户端连接" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource StatCardStyle}">
                <StackPanel Orientation="Horizontal">
                    <Border Width="38" Height="38" CornerRadius="8" Background="#1416A34A">
                        <ui:SymbolIcon Symbol="ArrowImport24" FontSize="20" Foreground="#16A34A" />
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource StatValueStyle}" Text="{Binding TotalRxText, Mode=OneWay}" />
                        <TextBlock Style="{StaticResource StatLabelStyle}" Text="累计接收（设备→网络）" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource StatCardStyle}">
                <StackPanel Orientation="Horizontal">
                    <Border Width="38" Height="38" CornerRadius="8" Background="#14B45309">
                        <ui:SymbolIcon Symbol="ArrowUpload24" FontSize="20" Foreground="#B45309" />
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource StatValueStyle}" Text="{Binding TotalTxText, Mode=OneWay}" />
                        <TextBlock Style="{StaticResource StatLabelStyle}" Text="累计发送（网络→设备）" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- 工具栏 -->
        <Grid Grid.Row="3" Margin="32,12,32,12">
            <StackPanel Orientation="Horizontal">
                <ui:Button Appearance="Primary" Command="{Binding AddMappingCommand}" MinWidth="118">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="AddCircle24" />
                        <TextBlock Text="新增映射" Margin="6,0,0,0" />
                    </StackPanel>
                </ui:Button>
                <ui:Button Margin="10,0,0,0" Command="{Binding StartAllCommand}" MinWidth="100">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="PlayCircle24" />
                        <TextBlock Text="全部启动" Margin="6,0,0,0" />
                    </StackPanel>
                </ui:Button>
                <ui:Button Margin="10,0,0,0" Command="{Binding StopAllCommand}" MinWidth="100">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="RecordStop24" />
                        <TextBlock Text="全部停止" Margin="6,0,0,0" />
                    </StackPanel>
                </ui:Button>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <ui:SymbolIcon Symbol="Earth24" FontSize="15"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <TextBlock Margin="6,0,0,0" FontSize="12.5" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           ToolTip="客户端应使用以下局域网地址连接（而非 0.0.0.0）">
                    <Run Text="本机局域网地址：" /><Run Text="{Binding LocalIpSummary, Mode=OneWay}" FontWeight="Medium" />
                </TextBlock>
                <ui:Button ToolTip="刷新串口列表与网络地址" Margin="14,0,0,0"
                           Command="{Binding RefreshPortsCommand}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="ArrowSync24" />
                        <TextBlock Text="刷新" Margin="6,0,0,0" />
                    </StackPanel>
                </ui:Button>
            </StackPanel>
        </Grid>

        <!-- 映射列表 -->
        <ScrollViewer Grid.Row="4" Margin="32,0,32,0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <ItemsControl ItemsSource="{Binding Mappings}"
                              ItemTemplate="{StaticResource MappingCardTemplate}" />
                <Border Background="{DynamicResource ControlFillColorSecondaryBrush}"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="28,36"
                        Visibility="{Binding HasMappings, Converter={StaticResource InverseBoolToVisibility}}">
                    <StackPanel HorizontalAlignment="Center">
                        <ui:SymbolIcon Symbol="SerialPort24" FontSize="34"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        <TextBlock Text="还没有映射" FontSize="16" Margin="0,12,0,4" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="点击“新增映射”，把一个物理串口桥接到 TCP 端口，即可开始通信。" FontSize="13"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- 底部：防火墙提示 + 版本 -->
        <StackPanel Grid.Row="5" Margin="32,8,32,14">
            <Border Background="#14B45309" BorderBrush="#55B45309" BorderThickness="1"
                    CornerRadius="6" Padding="14,10"
                    Visibility="{Binding FirewallWarningVisible, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="ShieldTask24" FontSize="17" Foreground="#B45309" />
                        <TextBlock Margin="10,0,0,0" FontSize="12.5" VerticalAlignment="Center" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                            <Run Text="尚未检测到本程序的防火墙入站规则。若局域网设备无法连接，请添加放行规则（原始 TCP 透传不含加密与身份认证，请仅在可信局域网使用）。" />
                        </TextBlock>
                    </StackPanel>
                    <ui:Button HorizontalAlignment="Right" Appearance="Caution"
                               Content="添加防火墙规则" Command="{Binding AddFirewallRuleCommand}" />
                </Grid>
            </Border>
            <Grid Margin="0,10,0,0">
                <TextBlock FontSize="11.5" HorizontalAlignment="Right"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                    <Run Text="SerialBridge v" /><Run Text="{Binding AppVersion, Mode=OneWay}" />
                    <Run Text=" · 数据目录 " /><Run Text="{Binding DataDirText, Mode=OneWay}" />
                    <Run Text=" · " />
                    <Hyperlink NavigateUri="https://github.com/SuperStrain/SerialBridge"
                               RequestNavigate="OnOpenGitHub"
                               Foreground="#2563EB" ToolTip="在 GitHub 上查看源码与提交问题">
                        <Run Text="GitHub 开源地址" />
                    </Hyperlink>
                </TextBlock>
                <TextBlock FontSize="11.5" HorizontalAlignment="Left"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           Text="{Binding RefreshedAtText, Mode=OneWay}" />
            </Grid>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
