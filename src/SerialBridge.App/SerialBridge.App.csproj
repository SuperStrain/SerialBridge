<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.17763.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <WindowsSdkPackageVersion>10.0.17763.56</WindowsSdkPackageVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>SerialBridge.App</RootNamespace>
    <AssemblyName>SerialBridge</AssemblyName>
    <ApplicationIcon>Assets/app.ico</ApplicationIcon>
    <Version>1.3.12</Version>
    <FileVersion>1.3.12</FileVersion>
    <AssemblyVersion>1.3.12</AssemblyVersion>
    <InformationalVersion>1.3.12</InformationalVersion>
    <SatelliteResourceLanguages>zh-Hans;en</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.3.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
    <PackageReference Include="System.Management" Version="10.0.12" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets/app.ico" />
    <Resource Include="Assets/app-logo.png" />
  </ItemGroup>
  <ItemGroup>
    <None Include="Assets/terminal/**/*" CopyToOutputDirectory="PreserveNewest" Link="Assets/terminal/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\SerialBridge.Core\SerialBridge.Core.csproj" />
  </ItemGroup>
</Project>